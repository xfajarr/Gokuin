MAINNET_RPC=
MAINNET_WS=
SEPOLIA_RPC=
PROBER_PK=
SCORER_PK=
LISTENER_PK=
LISTENER_REGION=eu-central
API_URL=http://localhost:3000
API_ADMIN_TOKEN=
SUBGRAPH_URL=
PROBE_LEDGER_ADDRESS=
ROUTE_REGISTRY_ADDRESS=
SCORER_ADDRESS=

# Distributor: funds each freshly-rotated probe EOA and sweeps its leftover
# back after settlement (apps/api/src/chain/distributor.ts). Absent -> dry-run
# (see apps/api/README.md for exactly what that skips).
DISTRIBUTOR_PK=
# Gas headroom multiplier applied to a probe's own swap gas cost when sizing
# its funding (e.g. 1.5 = 50% headroom against fee spikes between funding and dispatch).
FUNDING_GAS_HEADROOM_MULTIPLIER=1.5
# Max size, in bps of (swap value + gas budget), of the random surplus added
# on top so no two probes are ever funded the same amount.
FUNDING_AMOUNT_JITTER_BPS=250
# Minimum delay (ms) between successive funding transactions within one cycle.
FUNDING_MIN_DELAY_MS=0
# Additional randomized delay (ms) on top of FUNDING_MIN_DELAY_MS, resampled per funding.
FUNDING_JITTER_DELAY_MS=0
# Multiplier on the plain sweep-transfer gas cost used to decide whether a
# probe's leftover balance is dust not worth sweeping.
SWEEP_GAS_BUFFER_MULTIPLIER=1.2
