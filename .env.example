MAINNET_RPC=
MAINNET_WS=
SEPOLIA_RPC=
PROBER_PK=
SCORER_PK=
LISTENER_PK=
LISTENER_REGION=eu-central
API_URL=http://localhost:3000
API_ADMIN_TOKEN=
SUBGRAPH_URL=
PROBE_LEDGER_ADDRESS=
ROUTE_REGISTRY_ADDRESS=
SCORER_ADDRESS=

# Distributor: funds each freshly-rotated probe EOA and sweeps its leftover
# back after settlement (apps/api/src/chain/distributor.ts). Absent -> dry-run
# (see apps/api/README.md for exactly what that skips).
DISTRIBUTOR_PK=
# Gas headroom multiplier applied to a probe's own swap gas cost when sizing
# its funding (e.g. 1.5 = 50% headroom against fee spikes between funding and dispatch).
FUNDING_GAS_HEADROOM_MULTIPLIER=1.5
# Max size, in bps of (swap value + gas budget), of the random surplus added
# on top so no two probes are ever funded the same amount.
FUNDING_AMOUNT_JITTER_BPS=250
# Minimum delay (ms) between successive funding transactions within one cycle.
FUNDING_MIN_DELAY_MS=0
# Additional randomized delay (ms) on top of FUNDING_MIN_DELAY_MS, resampled per funding.
FUNDING_JITTER_DELAY_MS=0
# Multiplier on the plain sweep-transfer gas cost used to decide whether a
# probe's leftover balance is dust not worth sweeping.
SWEEP_GAS_BUFFER_MULTIPLIER=1.2

# --- deployment (contracts/script/Deploy.s.sol) -------------------------------
# Broadcast key for the Sepolia deploy.
DEPLOYER_PK=
# Address the API signs ledger writes with — becomes ProbeLedger.prober, immutable.
# Derive it from PROBER_PK: cast wallet address --private-key $PROBER_PK
PROBER_ADDRESS=
# Chainlink's own CRE Forwarder on Sepolia, from the CRE docs for your workflow.
# NOTE: Scorer.creForwarder is NOT set to this — the deploy script points Scorer at
# the ScorerReportReceiver adapter, which in turn only accepts this address.
CRE_FORWARDER=
# ENSv2 ETHRegistry on Sepolia — verified live, not the v1 registry.
# The old flat v1 registry (0x0000...2e1e) does NOT hold ENSv2 names; pointing at it
# is what made the first deploy revert.
ETH_REGISTRY=0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
# Optional: contract verification on deploy.
ETHERSCAN_API_KEY=

# --- substreams ---------------------------------------------------------------
# Free tier from streamingfast.io, pinax.network, or thegraph.market.
# Needed to run the module against the fixtures and to publish the package.
SUBSTREAMS_API_TOKEN=
SUBSTREAMS_ENDPOINT=mainnet.eth.streamingfast.io:443
